@PACKAGE_INIT@

include(CMakeFindDependencyMacro)

set(_TorchDelegate_saved_module_path "${CMAKE_MODULE_PATH}")
list(PREPEND CMAKE_MODULE_PATH "${CMAKE_CURRENT_LIST_DIR}/modules")

# Mark consumer mode so that Find modules can distinguish development builds
# (which may create stub symlinks) from installed-package consumers.
set(TORCH_DELEGATE_CONFIG_MODE TRUE)

# Public dependencies: the public headers (epair_model_loader.h) expose GE types
# such as ge::Graph, ge::AscendString, and gert::Tensor. Consumers need these
# targets for both compile-time header resolution and link-time symbol resolution.
# All other CANN libraries (acl_rt, ge_runner_v2, ascend_hal, runtime, securec)
# are private to libtorch_delegate_backend.so and are resolved at runtime via
# its DT_NEEDED entries + LD_LIBRARY_PATH.
find_dependency(graph REQUIRED)
find_dependency(graph_base REQUIRED)
find_dependency(metadef REQUIRED)

unset(TORCH_DELEGATE_CONFIG_MODE)

set(CMAKE_MODULE_PATH "${_TorchDelegate_saved_module_path}")
unset(_TorchDelegate_saved_module_path)

include("${CMAKE_CURRENT_LIST_DIR}/TorchDelegateTargets.cmake")

# Note: INTERFACE_LINK_LIBRARIES for graph/graph_base/metadef are already
# propagated from the exported TorchDelegateTargets.cmake (they are PUBLIC
# dependencies of torch_delegate_backend).  Do NOT append private CANN libs
# (acl_rt, ge_runner_v2, etc.) or libtorch_cpu here — they are not needed
# by consumer code and would leak build-directory paths into the consumer
# binary's RPATH.

if(NOT TARGET torch_delegate_backend)
    add_library(torch_delegate_backend INTERFACE IMPORTED)
    set_target_properties(torch_delegate_backend PROPERTIES
        INTERFACE_INCLUDE_DIRECTORIES "${PACKAGE_PREFIX_DIR}/inc"
        INTERFACE_LINK_LIBRARIES "TorchDelegate::torch_delegate_backend"
    )
endif()

set(TorchDelegate_INCLUDE_DIRS "${PACKAGE_PREFIX_DIR}/inc")
set(TorchDelegate_LIBRARIES torch_delegate_backend)

check_required_components(TorchDelegate)
